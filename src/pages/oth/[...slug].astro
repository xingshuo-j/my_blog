---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { buildArticlePaths } from "../../utils/content";

export async function getStaticPaths() {
  return buildArticlePaths(import.meta.glob('../../oth/*.md', { eager: true }));
}

const { entry } = Astro.props;
const { frontmatter } = entry;
const headings = entry.getHeadings ? entry.getHeadings() : [];
---

<ArticleLayout frontmatter={frontmatter} headings={headings}>
  <entry.Content />
</ArticleLayout>
