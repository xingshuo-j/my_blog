---
import "../../style/base.css";
import Toc from "../components/Toc.astro";
const { frontmatter, headings = [] } = Astro.props;
const year = new Date().getFullYear();
const articleTitle = frontmatter?.title || "文章";
const description = frontmatter?.excerpt || "xing's blog 文章";
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// 当前页面对应的导航菜单高亮：按路径前缀匹配分区
const pathName = Astro.url.pathname;
const isLearnArticle = pathName.startsWith("/learn/");
const isLifeArticle = pathName.startsWith("/life/");
const isOthArticle = pathName.startsWith("/oth/");
const homeNavClass = (isLearnArticle || isLifeArticle || isOthArticle) ? "" : "active";
const learnNavClass = isLearnArticle ? "active" : "";
const lifeNavClass = isLifeArticle ? "active" : "";
const othNavClass = isOthArticle ? "active" : "";
---

<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" />
        <script src="/js/code-copy.js" defer></script>
        <title>{articleTitle} | xing's blog</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="article" />
        <meta property="og:title" content={articleTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta name="twitter:card" content="summary" />
        <meta property="article:section" content={frontmatter?.category || ""} />
    </head>
    <body>
        <div id="highlight-gradient"></div>
        <div class="layout-wrapper full">
            <nav class="navbar" id="navbar">
                <a href="/" class="nav-logo">xing's blog</a>
                <div class="nav-right">
                    <ul class="nav-menu" id="nav-menu">
                        <li><a href="/" class={`nav-link ${homeNavClass}`}>首页</a></li>
                        <li><a href="/learn/" class={`nav-link ${learnNavClass}`}>学习杂记</a></li>
                        <li><a href="/life/" class={`nav-link ${lifeNavClass}`}>闲鱼生存日记</a></li>
                        <li><a href="/oth/" class={`nav-link ${othNavClass}`}>杂言小计</a></li>
                    </ul>
                    <a href="/" class="overlay-close-btn nav-back">&#x2190; 返回</a>
                    <button class="nav-toggle" id="nav-toggle" type="button"
                        aria-label="切换导航菜单" aria-expanded="false" aria-controls="nav-menu">
                        <span class="nav-toggle-bar"></span>
                        <span class="nav-toggle-bar"></span>
                        <span class="nav-toggle-bar"></span>
                    </button>
                </div>
            </nav>

            <div class="article-page-wrapper">
                <article class="article-content card-style">
                    <slot />
                </article>
                <Toc headings={headings} />
            </div>

            <footer class="footer">
                <div class="container">
                    <div class="footer-content">
                        <span>&copy; {year} xing's blog</span>
                    </div>
                </div>
            </footer>
        </div>

        <script>
            (function() {
                var navbar = document.getElementById('navbar');
                if (!navbar) return;
                function onScroll() {
                    if (window.scrollY > 10) {
                        navbar.classList.add('scrolled');
                    } else {
                        navbar.classList.remove('scrolled');
                    }
                }
                window.addEventListener('scroll', onScroll, { passive: true });
                onScroll();

                // 移动端汉堡菜单：展开 / 收起 + 键盘可访问 + 外部点击 / Esc 关闭
                var toggle = document.getElementById('nav-toggle');
                var menu = document.getElementById('nav-menu');
                if (toggle && menu) {
                    function setOpen(open) {
                        navbar.classList.toggle('nav-open', open);
                        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                    }
                    toggle.addEventListener('click', function () {
                        setOpen(!navbar.classList.contains('nav-open'));
                    });
                    toggle.addEventListener('keydown', function (e) {
                        if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
                            e.preventDefault();
                            setOpen(!navbar.classList.contains('nav-open'));
                        }
                    });
                    // 点击菜单项后自动收起
                    menu.addEventListener('click', function (e) {
                        if (e.target && e.target.closest && e.target.closest('a.nav-link')) setOpen(false);
                    });
                    // 外部点击 / Esc 关闭
                    document.addEventListener('click', function (e) {
                        if (!navbar.classList.contains('nav-open')) return;
                        if (!navbar.contains(e.target)) setOpen(false);
                    });
                    document.addEventListener('keydown', function (e) {
                        if (e.key === 'Escape') setOpen(false);
                    });
                }

                // ---- 标题导航（TOC）移动端折叠 ----
                var tocToggle = document.getElementById('toc-toggle');
                var tocWrapper = document.getElementById('toc-wrapper');
                if (tocToggle && tocWrapper) {
                    tocToggle.addEventListener('click', function () {
                        var open = !tocWrapper.classList.contains('toc-open');
                        tocWrapper.classList.toggle('toc-open', open);
                        tocToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                    });
                    // 点击目录链接后自动收起（仅移动端）
                    document.getElementById('toc-list').addEventListener('click', function (e) {
                        if (window.innerWidth < 1024) {
                            tocWrapper.classList.remove('toc-open');
                            tocToggle.setAttribute('aria-expanded', 'false');
                        }
                    });
                }

                // ---- TOC 滚动监听高亮 ----
                (function () {
                    var tocLinks = document.querySelectorAll('.toc-link');
                    if (!tocLinks.length) return;
                    var headingIds = [];
                    for (var i = 0; i < tocLinks.length; i++) {
                        var href = tocLinks[i].getAttribute('href');
                        if (href && href.charAt(0) === '#') {
                            headingIds.push({ el: document.getElementById(href.slice(1)), link: tocLinks[i] });
                        }
                    }
                    // 过滤掉找不到目标元素的项
                    headingIds = headingIds.filter(function (item) { return item.el; });
                    if (!headingIds.length) return;

                    function setActive(id) {
                        for (var i = 0; i < tocLinks.length; i++) tocLinks[i].classList.remove('active');
                        if (id) id.classList.add('active');
                    }

                    var observer = new IntersectionObserver(function (entries) {
                        // 取第一个进入视口的 heading（靠近顶部）
                        for (var i = 0; i < entries.length; i++) {
                            if (entries[i].isIntersecting) {
                                setActive(entries[i].target._tocLink || null);
                                return;
                            }
                        }
                    }, { rootMargin: '-80px 0px -70% 0px' });

                    for (var i = 0; i < headingIds.length; i++) {
                        headingIds[i].el._tocLink = headingIds[i].link;
                        observer.observe(headingIds[i].el);
                    }
                })();
            })();
        </script>
    </body>
</html>
